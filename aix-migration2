## Option B: If You MUST Have Individual Encrypted Files in S3

When downstream consumers need per-file access (not a blob):

```ksh
#!/usr/bin/ksh
# Stream-extract + encrypt + upload per file, NO temp disk writes
# Uses process substitution and named pipes

upload_tgz_per_file() {
    typeset tgzfile="$1"
    typeset basename="${tgzfile##*/}"
    typeset datepart="${basename%%_*}"
    typeset yyyy="${datepart:0:4}"
    typeset mm="${datepart:4:2}"
    typeset dd="${datepart:6:2}"
    typeset s3prefix="${S3_BUCKET}/${yyyy}/${mm}/${dd}"
    typeset FIFO="/tmp/fifo_$$"

    # Extract file list from tgz first (fast, metadata only)
    # Then stream-extract each file via tar -xOf (stdout, no disk)

    tar -tzf "$tgzfile" | grep -v '/$' | \
    while read filepath; do
        typeset fname="${filepath##*/}"
        typeset s3path="${s3prefix}/${fname}.enc"

        # Extract single file to stdout | encrypt | upload
        # -xOf: extract, stdout mode, specific file
        tar -xzOf "$tgzfile" "$filepath" | \
            openssl enc -aes-256-ctr \
                -pass file:"$KEY_FILE" | \
            aws s3 cp - "$s3path" \
                --expected-size 102400 \
                --no-progress &

        # Throttle: keep max 200 background jobs
        while (( $(jobs | wc -l) >= 200 )); do
            wait -n 2>/dev/null || sleep 0.1
        done
    done
    wait
}
```

> ⚠️ Option B is **much slower** for 100K files — still hits the S3 PUT/request problem. Use Option A unless per-file S3 access is a hard requirement.

