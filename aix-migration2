## Option C: Hybrid — Encrypt Per File, Re-tar, Stream Upload

Best of both: individual file encryption (different keys/IV per file) + single S3 object:

```ksh
#!/usr/bin/ksh
# tar -xz | encrypt each entry | bundle back into tar | s3 cp

upload_tgz_hybrid() {
    typeset tgzfile="$1"
    typeset basename="${tgzfile##*/}"
    typeset datepart="${basename%%_*}"
    typeset yyyy="${datepart:0:4}"
    typeset mm="${datepart:4:2}"
    typeset dd="${datepart:6:2}"
    typeset s3path="${S3_BUCKET}/${yyyy}/${mm}/${dd}/${basename%.tgz}.enc.tar"
    typeset TMPDIR="/tmp/enc_$$"

    # Use RAM-backed tmpfs to avoid disk I/O entirely
    # Mount: mount -t tmpfs -o size=32G tmpfs /mnt/ramfs
    typeset RAMDIR="/mnt/ramfs/enc_$$"
    mkdir -p "$RAMDIR"

    # Extract + encrypt in parallel, write to RAM
    tar -xzf "$tgzfile" -C "$RAMDIR" \
        --to-command='
            fname="$TAR_FILENAME"
            openssl enc -aes-256-ctr \
                -pass file:"'"$KEY_FILE"'" \
                -in /dev/stdin \
                -out "${fname}.enc"
        '

    # Re-tar from RAM → stream to S3
    tar -cf - -C "$RAMDIR" . | \
        aws s3 cp - "$s3path" \
            --expected-size $((25 * 1024 * 1024 * 1024)) \
            --no-progress

    rm -rf "$RAMDIR"
}
```

