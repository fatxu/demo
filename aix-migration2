## Option A: Stream tar → encrypt → S3 (Recommended)

### encrypt-stream.ksh (per-file encryption inside tar pipe)

```ksh
#!/usr/bin/ksh
# Reads tar stream stdin, encrypts each entry, writes tar stream stdout
# Uses: ratarmount / tarfile approach via openssl per-entry

# Simpler: encrypt the whole tar stream as one blob (fastest)
# Use AES-256-CTR - streamable, no padding, no block boundary issues

encrypt_stream() {
    typeset passphrase_file="$1"
    openssl enc -aes-256-ctr \
        -pass file:"$passphrase_file" \
        -bufsize 131072    # 128KB buffer matches your file sizes
}
```

### Main upload script

```ksh
#!/usr/bin/ksh

SOURCE_DIR="/data/tgz"
S3_BUCKET="s3://your-bucket"
KEY_FILE="/secure/enc.key"
PARALLEL_WORKERS=12        # one per vCPU for CPU-bound encryption
LOG_DIR="/tmp/upload_logs"
FAILED="/tmp/failed.txt"

mkdir -p "$LOG_DIR"
> "$FAILED"

upload_one() {
    typeset tgzfile="$1"
    typeset basename="${tgzfile##*/}"          # 20240315_data.tgz
    typeset datepart="${basename%%_*}"         # 20240315
    
    # Parse date → S3 prefix
    typeset yyyy="${datepart:0:4}"
    typeset mm="${datepart:4:2}"
    typeset dd="${datepart:6:2}"
    typeset s3key="${yyyy}/${mm}/${dd}/${basename%.tgz}.tar.enc"
    typeset s3path="${S3_BUCKET}/${s3key}"
    typeset log="${LOG_DIR}/${basename}.log"

    print "START: $basename → $s3key"

    # THE CORE PIPELINE:
    # 1. decompress tgz → raw tar stream
    # 2. encrypt entire stream (AES-256-CTR, streamable)
    # 3. pipe directly into s3 cp multipart upload
    # Zero files written to disk!

    zcat "$tgzfile" | \
        openssl enc -aes-256-ctr \
            -pass file:"$KEY_FILE" \
            -bufsize 131072 | \
        aws s3 cp - "$s3path" \
            --expected-size $((20 * 1024 * 1024 * 1024)) \
            --no-progress \
            --storage-class STANDARD \
            > "$log" 2>&1

    typeset rc=$?
    if (( rc != 0 )); then
        print "$tgzfile" >> "$FAILED"
        print "FAILED: $basename (rc=$rc)"
    else
        print "OK: $basename → $s3path"
    fi
    return $rc
}

export KEY_FILE S3_BUCKET LOG_DIR FAILED

# Process all tgz files in parallel
find "$SOURCE_DIR" -name "*.tgz" -type f | sort | \
    xargs -P "$PARALLEL_WORKERS" -I {} \
    ksh -c '
        tgzfile="{}"
        basename="${tgzfile##*/}"
        datepart="${basename%%_*}"
        yyyy="${datepart:0:4}"
        mm="${datepart:4:2}"
        dd="${datepart:6:2}"
        s3key="${yyyy}/${mm}/${dd}/${basename%.tgz}.tar.enc"

        zcat "$tgzfile" | \
            openssl enc -aes-256-ctr \
                -pass file:"'"$KEY_FILE"'" \
                -bufsize 131072 | \
            aws s3 cp - "'"$S3_BUCKET"'/${s3key}" \
                --expected-size $((20 * 1024 * 1024 * 1024)) \
                --no-progress \
                > "'"$LOG_DIR"'/${basename}.log" 2>&1

        rc=$?
        [[ $rc -ne 0 ]] && echo "$tgzfile" >> "'"$FAILED"'"
        echo "$rc $basename"
    '

print "\n=== Done ==="
print "Failed: $(wc -l < $FAILED)"
```

