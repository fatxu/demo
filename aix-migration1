## Solution 2: Tar-on-the-fly Per Folder (Best Throughput)

Since you already proved tgz hits 100 MB/s — **keep doing that per folder**:

```ksh
#!/usr/bin/ksh

SOURCE_BASE="/data/folders"
S3_BUCKET="s3://your-bucket/archives"
PARALLEL_WORKERS=12   # one per vCPU

upload_folder_as_tar() {
    typeset folder="$1"
    typeset folder_name="${folder##*/}"

    print "Uploading $folder_name as stream..."

    # Stream tar directly to S3 — no disk write, no temp file
    tar -czf - -C "$SOURCE_BASE" "$folder_name" | \
        aws s3 cp - "${S3_BUCKET}/${folder_name}.tgz" \
            --expected-size $((10 * 1024 * 1024 * 1024)) \
            --no-progress

    return $?
}

find "$SOURCE_BASE" -mindepth 1 -maxdepth 1 -type d | \
    xargs -P "$PARALLEL_WORKERS" -I {} \
    ksh -c '
        folder="{}"
        folder_name="${folder##*/}"
        tar -czf - -C "'"$SOURCE_BASE"'" "$folder_name" | \
            aws s3 cp - "'"$S3_BUCKET"'/${folder_name}.tgz" \
                --expected-size $((10 * 1024 * 1024 * 1024)) \
                --no-progress
        echo "$? $folder_name"
    '
```

**Why this works:**
```
tar czf streams folder → pipe → aws s3 cp reads pipe → multipart upload
= same code path as your 100MB/s tgz test
= 12 parallel folder streams × ~80MB/s each (CPU-bound on gzip)
```

If you don't need compression (already compressed files), use `tar -cf` (no gzip) → even faster:

```ksh
tar -cf - -C "$SOURCE_BASE" "$folder_name" | \
    aws s3 cp - "${S3_BUCKET}/${folder_name}.tar" \
        --expected-size $((10 * 1024 * 1024 * 1024)) \
        --no-progress
```

